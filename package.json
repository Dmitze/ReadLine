{
  "name": "readline-library-bot",
  "version": "1.0.0",
  "description": "Telegram bot for military library management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon",
    "init-admin": "node dist/init-admin.js",
    "backup": "node scripts/backup-db.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "bull": "^4.16.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "fast-levenshtein": "^3.0.0",
    "node-cron": "^3.0.3",
    "redis": "^5.9.0",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.24",
    "@types/sqlite3": "^3.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
