# ============================================
# READLINE LIBRARY BOT - ENVIRONMENT VARIABLES
# ============================================

# Telegram Bot Configuration
# ==========================
# Отримайте токен від @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Admin Configuration
# ===================
# Ваш Telegram User ID (отримайте через @userinfobot)
ADMIN_ID=your_telegram_user_id

# Database Configuration
# =====================
# Шлях до файлу бази даних SQLite
DB_PATH=./database/library.db

# Optional: Default Book Cover
# ============================
# File ID дефолтного зображення обкладинки книги
# Залиште порожнім якщо не маєте
DEFAULT_BOOK_COVER_FILE_ID=

# Optional: Logging Configuration
# ===============================
# Рівень логування: debug, info, warn, error
LOG_LEVEL=info

# AI Configuration (Optional)
# ===========================
# Google Gemini API Key для AI-помічника
# Отримайте на https://makersuite.google.com/app/apikey
# Якщо не заповните - AI функції будуть недоступні
GEMINI_API_KEY=

# Модель для використання (gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Redis & BullMQ Configuration
# =============================
# Redis server host
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis password (if required)
# REDIS_PASSWORD=your_redis_password

# ============================================
# ІНСТРУКЦІЇ ДЛЯ НАЛАШТУВАННЯ:
# ============================================
#
# 1. Скопіюйте цей файл в .env:
#    cp .env.example .env
#
# 2. Отримайте токен бота:
#    - Відкрийте @BotFather в Telegram
#    - Виконайте /newbot
#    - Слідуйте інструкціям
#    - Скопіюйте отриманий токен в BOT_TOKEN
#
# 3. Отримайте свій User ID:
#    - Відкрийте @userinfobot в Telegram
#    - Надішліть /start
#    - Скопіюйте ваш ID в ADMIN_ID
#
# 4. Запустіть бота:
#    npm install
#    npm run build
#    npm run init-admin
#    npm start
#
# ============================================

# ВАЖЛИВО: Ніколи не комітьте файл .env в Git!
# Він містить конфіденційну інформацію.
